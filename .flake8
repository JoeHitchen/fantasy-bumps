[flake8]
max-line-length = 99
exclude = 
    .git,
    .venv,
    venv,
    __pycache__,
    *.pyc,
    migrations,
    manage.py
ignore = E251,E303,W391,W503,I300
per-file-ignores =
    typing/django_celery_beat/models.pyi:F821
import-order-style = pep8app
application-package-names = core,common,fantasy,integrations
multiline-quotes = '''

